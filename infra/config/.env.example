# =============================================================================
# Giljobi Infrastructure — Environment Configuration Template
# -----------------------------------------------------------------------------
# Copy this file to create environment-specific configs:
#   cp .env.example .env.development
#   cp .env.example .env.production
#
# The active config is symlinked to ../.env:
#   ln -sf config/.env.development ../.env
#
# Docker Compose automatically reads .env from the compose file directory.
# =============================================================================

# =============================================================================
# PostgreSQL — Pipeline Data DB
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=giljobi

# =============================================================================
# Airflow — Metadata DB
# =============================================================================
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# =============================================================================
# Airflow — Application
# =============================================================================
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# =============================================================================
# Airflow — Workers
# =============================================================================
AIRFLOW_WORKER_REPLICAS=1
AIRFLOW_WORKER_MEMORY=2g

# =============================================================================
# Spark — Workers
# =============================================================================
SPARK_WORKER_REPLICAS=1
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=2g

# =============================================================================
# Pipeline — Data DB Connection
# =============================================================================
# Connection string for pipeline data (job_postings, noc_titles, etc.)
# Local:  postgresql://postgres:postgres@market-trend-db:5432/giljobi
# Neon:   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
PIPELINE_DB_CONN=postgresql://postgres:postgres@market-trend-db:5432/giljobi

# Whether DAGs should start/stop the pipeline DB container.
# true  = DAG calls up.sh/down.sh postgres (local Docker DB)
# false = External DB (Neon, RDS, etc.) — no container management
MANAGE_PIPELINE_DB=true

# =============================================================================
# Pipeline — Spark Management
# =============================================================================
# Whether DAGs should start/stop the Spark cluster.
# true  = DAG calls up.sh/down.sh spark (local Docker Spark)
# false = External Spark cluster — no container management
MANAGE_SPARK=true
