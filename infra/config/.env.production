# =============================================================================
# Production Environment
# -----------------------------------------------------------------------------
# Scaled resources for production workloads.
# =============================================================================

# PostgreSQL — Pipeline Data DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=giljobi

# Airflow — Metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Airflow — Application
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Airflow — Workers
AIRFLOW_WORKER_REPLICAS=3
AIRFLOW_WORKER_MEMORY=4g

# Spark — Workers
SPARK_WORKER_REPLICAS=5
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=8g

# Pipeline — Data DB (Neon cloud)
PIPELINE_DB_CONN=postgresql://user:pass@host.neon.tech/dbname?sslmode=require
MANAGE_PIPELINE_DB=false

# Pipeline — Spark (local Docker, scaled)
MANAGE_SPARK=true
