# =============================================================================
# Development Environment
# -----------------------------------------------------------------------------
# Local development defaults. Minimal resources, single workers.
# =============================================================================

# PostgreSQL — Pipeline Data DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=giljobi

# Airflow — Metadata DB
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Airflow — Application
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Airflow — Workers
AIRFLOW_WORKER_REPLICAS=1
AIRFLOW_WORKER_MEMORY=2g

# Spark — Workers (skill-demand)
SPARK_WORKER_REPLICAS=1
SPARK_WORKER_CORES=1
SPARK_WORKER_MEMORY=2g

# Spark — Workers (skill-demand)
# Replicas/cores/memory managed by DAG params and docker-compose defaults

# Pipeline — Market Trend DB (local Docker)
PIPELINE_DB_CONN=postgresql://postgres:postgres@market-trend-db:5432/giljobi
MANAGE_PIPELINE_DB=true

# Pipeline — Skill Demand DB (separate, local Docker)
SKILL_DEMAND_DB_CONN=postgresql://postgres:postgres@skill-demand-db:5432/giljobi_sd
# Optional secondary target — Neon cloud. Empty = skip (local-only).
# Example: SKILL_DEMAND_DB_CONN_NEON=postgresql://neondb_owner:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
SKILL_DEMAND_DB_CONN_NEON=postgresql://neondb_owner:npg_qSpgiAJ9B6uy@ep-bitter-rice-ajouqywl.c-3.us-east-2.aws.neon.tech/neondb?sslmode=require

# Pipeline — Spark (local Docker)
MANAGE_SPARK=true
